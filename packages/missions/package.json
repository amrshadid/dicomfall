{
  "name": "@dicomfall/missions",
  "version": "0.0.0",
  "private": true,
  "description": "The game's content: the stages and their regions, the skill tree, the concepts, the Field Guide and every mission with its story, and the loader that checks it all.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./utils": "./src/utils/index.ts"
  },
  "imports": {
    "#test/*": "./src/test/*.ts",
    "#types/*": "./src/types/*.ts",
    "#utils/*": "./src/utils/*.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit -p .",
    "test": "vitest run",
    "content:report": "node scripts/content-report.ts"
  },
  "dependencies": {
    "@dicomfall/core": "workspace:*",
    "@dicomfall/game": "workspace:*",
    "@dicomfall/machine": "workspace:*",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "vite": "^8.3.7"
  }
}
